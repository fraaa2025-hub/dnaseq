SLIDINGWINDOW:4:20 MINLEN:25
#for single end
trimmomatic SE -phred33 \
SRR2589044.fastq.gz \
SRR2589044.trim.fastq.gz \
ILLUMINACLIP:TruSeq3-SE.fa:2:30:10 \
SLIDINGWINDOW:4:20 \
MINLEN:25




fastqc *.fastq*


# ref genome	
curl -L -o ecoli_rel606.fasta.g
z http://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/017/985/GCA_000017985.1_ASM1798v1/GCA_000017985.1_ASM1798v1_genomic.fna


mkdir -p results/sam_res/bam_res/bcf_res/vcf

conda install bwa

#go to ref genome
mv ecoli_rel606.gz ecoli_rel606.zip
unzip ecoli_rel606.zip
find ncbi_dataset -name "*.fna"
cp ncbi_dataset/data/GCF_020097475.1/GCF_020097475.1_ASM2009747v1_genomic.fna ecoli_reference.fasta
 bwa index ecoli_reference.fasta
 
 
 
 bwa mem data/reference/ecoli_reference.fasta \
data/trimmed_fastq/SRR2589044_1.trim.fastq.gz \
data/trimmed_fastq/SRR2589044_2.trim.fastq.gz \
> results/sam_res/SRR2589044.aligned.sam
 
 samtools view -S -b results/sam_res/SRR2589044.aligned.sam > results/bam/SRR2589044.aligned.bam
 
 samtools sort results/bam/SRR2589044.aligned.bam \
-o results/bam/SRR2589044.aligned.sorted.bam
 
 
 
 bcftools mpileup -f data/refgenome/ecoli_reference.fasta results/bam_res/SRR2589044.aligned.sorted.bam | bcftools call -mv -o results/vcf/SRR2589044.variants.vcf

# for count.txt
featureCounts \
-a GCF_020097475.1_ASM2009747v1_genomic.gff \
-o count.txt \
results/bam_res/SRR2589044.aligned.sorted.bam
